NODE_ENV=development
PORT=3000
WEB_ORIGIN=http://localhost:5173
VOXORA_DATA_DIR=.data

# Translation provider: mock | gemini
TRANSLATION_PROVIDER=mock

# Gemini authentication: vertex (service account) | api-key
GEMINI_AUTH=vertex
GEMINI_API_KEY=replace_me
GCP_PROJECT=replace_me
GCP_LOCATION=global
GOOGLE_APPLICATION_CREDENTIALS=path/to/service-account.json
GEMINI_LIVE_MODEL=gemini-3.5-live-translate-preview

# Local workspace login credentials. Replace these in deployment secrets.
ADMIN_EMAIL=admin@voxora.local
ADMIN_PASSWORD=replace_with_a_strong_admin_password
USER_EMAIL=user@voxora.local
USER_PASSWORD=replace_with_a_strong_user_password
